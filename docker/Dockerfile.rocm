# IGM 3.2.1 on AMD GPUs: AMD's ROCm TensorFlow 2.17 image (same TF as the NVIDIA reference runs), IGM without
# its CUDA TensorFlow dependency.
#   docker build -t igm-bench:rocm -f docker/Dockerfile.rocm docker/
FROM rocm/tensorflow:rocm7.0.2-py3.12-tf2.17-dev
RUN pip install --no-cache-dir --no-deps igm-model==3.2.1 && \
    pip install --no-cache-dir "numpy>=1.26,<2.0" matplotlib scipy "netCDF4>=1.6.5" xarray rasterio pyproj \
        geopandas oggm salem pyyaml importlib_resources tqdm hydra-core omegaconf nvtx typeguard rich "optuna>=3.0"
ENV TF_USE_LEGACY_KERAS=0
